# Class diagram generated from the code with clang-uml:
#   cmake -S . -B build && clang-uml && plantuml docs/diagrams/*.puml
compilation_database_dir: build
output_directory: docs/diagrams

diagrams:
  classes:
    type: class
    glob:
      - src/**/*.cpp
    using_namespace: minesweeper
    include:
      namespaces:
        - minesweeper
    exclude:
      elements:
        - minesweeper::overloaded
